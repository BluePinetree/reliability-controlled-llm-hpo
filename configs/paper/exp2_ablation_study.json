{
  "experiment_name": "exp2_ablation_study",
  "dataset": "cifar100",
  "domain": "CV",
  "objective_metric": "accuracy",
  "maximize": true,
  "noise_model": "sub_gaussian",
  "budget_T": 25,
  "ablation_components": ["legacy_full", "episodic_search", "coupled_soft_risk"],
  "appendix_components": ["near_optimal_rerank", "meta_learning", "fail_safe"],
  "llm_model": "gpt-5.2",
  "llm_num_candidates": 5,
  "llm_temperature": 0.7,
  "llm_output_schema_version": "v1",
  "llm_seed": 42,
  "acq_type": "ucb",
  "kappa": 2.0,
  "exploration_schedule": { "type": "constant" },
  "mix_random_ratio": 0.0,
  "warm_start_trials": 0,
  "use_meta_learning": false,
  "use_variance_reduction": false,
  "max_safe_learning_rate": 0.01,
  "enable_fail_safe": false,
  "fail_safe_low_accuracy": 0.05,
  "fail_safe_patience": 4,
  "fail_safe_cooldown": 2,
  "conservative_lr_max": 0.0075,
  "enable_confidence_gated_episodic": true,
  "episodic_gate_min_episodes": 4,
  "episodic_gate_min_calibration_records": 4,
  "episodic_gate_min_coverage": 0.45,
  "episodic_gate_max_coverage": 0.95,
  "episodic_gate_max_calibration_error": 0.30,
  "episodic_gate_max_nll": 2.5,
  "enable_risk_aware_selection": true,
  "reliability_control_mode": "confidence_coupled",
  "episodic_gate_mode": "three_state",
  "episodic_gate_partial_memory_ratio": 0.5,
  "episodic_gate_partial_use_worst_diverse": false,
  "risk_sigma_penalty_mode": "excess_only",
  "risk_sigma_free_band": 0.03,
  "hard_risk_weight": 1.0,
  "soft_risk_weight": 0.05,
  "gate_coupled_soft_risk": true,
  "enable_near_optimal_rerank": true,
  "near_optimal_rerank_top_k": 3,
  "near_optimal_rerank_epsilon": 0.01,
  "near_optimal_rerank_key": "soft_risk",
  "risk_penalty_lambda": 0.20,
  "param_risk_penalty_weight": 0.05,
  "risk_high_lr_threshold": 0.005,
  "risk_high_dropout_threshold": 0.35,
  "risk_high_mix_threshold": 0.80,
  "risk_high_cutmix_threshold": 0.80,
  "risk_high_warmup_threshold": 800,
  "risk_small_batch_threshold": 32,
  "report_best_at": [1, 3, 5, 10, 15, 25],
  "report_accuracy_thresholds": [0.70, 0.74, 0.76, 0.78],
  "n_trials": 25,
  "n_seeds": 3,
  "output_dir": "./results/runs/exp2_ablation",
  "search_space": {
    "learning_rate": { "type": "float", "scale": "log", "bounds": [1e-5, 0.01] },
    "batch_size": { "type": "int", "scale": "linear", "bounds": [16, 256] },
    "weight_decay": { "type": "float", "scale": "linear", "bounds": [0.0, 0.001] },
    "optimizer": { "type": "categorical", "choices": ["Adam", "SGD", "RMSprop", "AdamW"] },
    "epochs": { "type": "int", "scale": "linear", "bounds": [50, 100] },
    "scheduler": { "type": "categorical", "choices": ["None", "StepLR", "CosineAnnealing", "ReduceLROnPlateau"] },
    "warmup_steps": { "type": "int", "scale": "linear", "bounds": [0, 1000] },
    "momentum": { "type": "float", "scale": "linear", "bounds": [0.8, 0.99] },
    "label_smoothing": { "type": "float", "scale": "linear", "bounds": [0.0, 0.2] },
    "dropout_rate": { "type": "float", "scale": "linear", "bounds": [0.0, 0.5] }
  }
}


