{
  "experiment_name": "exp1_baseline_comparison",
  "dataset": "cifar100",
  "domain": "CV",
  "method": "comparison",
  "objective_metric": "accuracy",
  "maximize": true,
  "noise_model": "sub_gaussian",
  "budget_T": 25,
  "methods_to_compare": ["LLM+Episodic", "LLM_only", "Bayesian", "TPE", "TPE+MV", "TPE+Pruner", "Random"],
  "llm_model": "gpt-5.2",
  "llm_num_candidates": 5,
  "llm_temperature": 0.7,
  "llm_output_schema_version": "v1",
  "llm_seed": null,
  "acq_type": "ucb",
  "kappa": 2.0,
  "tpe_seed": 42,
  "tpe_n_startup_trials": 12,
  "tpe_n_ei_candidates": 64,
  "tpe_consider_prior": true,
  "tpe_prior_weight": 1.0,
  "tpe_constant_liar": false,
  "tpe_mv_constant_liar": true,
  "tpe_pruner_type": "median",
  "tpe_pruner_n_startup_trials": 12,
  "tpe_pruner_n_warmup_steps": 0,
  "tpe_pruner_interval_steps": 1,
  "tpe_pruner_n_ei_candidates": 64,
  "exploration_schedule": { "type": "constant" },
  "mix_random_ratio": 0.0,
  "warm_start_trials": 0,
  "n_trials": 25,
  "n_seeds": 3,
  "use_episodic_search": true,
  "use_variance_reduction": true,
  "k_similar_episodes": 5,
  "enable_confidence_gated_episodic": true,
  "episodic_gate_min_episodes": 8,
  "episodic_gate_min_calibration_records": 8,
  "episodic_gate_min_coverage": 0.55,
  "episodic_gate_max_coverage": 0.85,
  "episodic_gate_max_calibration_error": 0.20,
  "episodic_gate_max_nll": 2.0,
  "enable_risk_aware_selection": true,
  "risk_penalty_lambda": 0.50,
  "param_risk_penalty_weight": 0.15,
  "risk_high_lr_threshold": 0.01,
  "risk_high_dropout_threshold": 0.35,
  "risk_high_mix_threshold": 0.80,
  "risk_high_cutmix_threshold": 0.80,
  "risk_high_warmup_threshold": 800,
  "risk_small_batch_threshold": 32,
  "report_best_at": [1, 3, 5, 10, 20, 25],
  "report_accuracy_thresholds": [0.50, 0.55, 0.58, 0.60],
  "output_dir": "./results/runs/exp1_baseline",
  "search_space": {
    "learning_rate": { "type": "float", "scale": "log", "bounds": [1e-5, 0.1] },
    "batch_size": { "type": "int", "scale": "linear", "bounds": [16, 256] },
    "weight_decay": { "type": "float", "scale": "linear", "bounds": [0.0, 0.001] },
    "optimizer": { "type": "categorical", "choices": ["Adam", "SGD", "RMSprop", "AdamW"] },
    "epochs": { "type": "int", "scale": "linear", "bounds": [50, 100] },
    "scheduler": { "type": "categorical", "choices": ["None", "StepLR", "CosineAnnealing", "ReduceLROnPlateau"] },
    "warmup_steps": { "type": "int", "scale": "linear", "bounds": [0, 1000] },
    "momentum": { "type": "float", "scale": "linear", "bounds": [0.8, 0.99] },
    "label_smoothing": { "type": "float", "scale": "linear", "bounds": [0.0, 0.2] },
    "dropout_rate": { "type": "float", "scale": "linear", "bounds": [0.0, 0.5] }
  }
}


