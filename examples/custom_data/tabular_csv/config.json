{
  "experiment_name": "custom_tabular_hpo",
  "dataset": "custom_tabular",
  "domain": "Tabular",
  "task_type": "classification",
  "seed": 42,
  "data": {
    "train_path": "examples/custom_data/tabular_csv/sample_train.csv",
    "label_column": "label",
    "id_columns": ["id"],
    "valid_fraction": 0.33,
    "stratify": false
  },
  "objective_metric": "accuracy",
  "maximize": true,
  "n_trials": 5,
  "search_space": {
    "learning_rate": { "type": "float", "scale": "log", "bounds": [1e-5, 1e-2] },
    "batch_size": { "type": "categorical", "choices": [32, 64, 128] },
    "weight_decay": { "type": "float", "scale": "linear", "bounds": [0.0, 0.001] },
    "dropout_rate": { "type": "float", "scale": "linear", "bounds": [0.0, 0.5] }
  }
}
